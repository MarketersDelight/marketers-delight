{
    "name": "marketers-delight/marketers-delight",
    "description": "MD Codebase Theme",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "afragen/git-updater": "^9",
        "composer/installers": "^1",
        "MarketersDelight/marketers-delight": "beta"
    },
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MarketersDelight/marketers-delight"
        }
    ],
    "extra": {
        "installer-paths": {
            "wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    }
}
