{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "name": "Background",
                    "slug": "background",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Surface",
                    "slug": "surface",
                    "color": "#F0F0F0"
                },
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#AE2525"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "#2E2E2E"
                },
                {
                    "name": "Tertiary",
                    "slug": "tertiary",
                    "color": "#DDDDDD"
                },
                {
                    "name": "Border",
                    "slug": "border",
                    "color": "#CCCCCC"
                },
                {
                    "name": "Highlight",
                    "slug": "highlight",
                    "color": "#FFFBCC"
                },
                {
                    "name": "Text Main",
                    "slug": "text-main",
                    "color": "#1E1E1E"
                },
                {
                    "name": "Text Secondary",
                    "slug": "text-secondary",
                    "color": "#777777"
                },
                {
                    "name": "Button",
                    "slug": "button",
                    "color": "#22A340"
                },
                {
                    "name": "White",
                    "slug": "white",
                    "color": "#FFFFFF"
                }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fontSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "22px"
                },
                {
                    "name": "Normal",
                    "slug": "normal",
                    "size": "20px"
                },
                {
                    "name": "Intro",
                    "slug": "intro",
                    "size": "24px"
                },
                {
                    "name": "H3",
                    "slug": "h3",
                    "size": "34px"
                },
                {
                    "name": "H2",
                    "slug": "h2",
                    "size": "41px"
                },
                {
                    "name": "H1",
                    "slug": "h1",
                    "size": "48px"
                },
                {
                    "name": "Huge",
                    "slug": "huge",
                    "size": "72px"
                }
            ],
            "fontFamilies": [
                {
                    "fontFamily": "system-ui, avenir next, avenir, segoe ui, helvetica neue, helvetica, Cantarell, Ubuntu, roboto, noto, arial, sans-serif",
                    "name": "Body",
                    "slug": "body"
                },
                {
                    "fontFamily": "PT Serif",
                    "name": "Heading",
                    "slug": "heading"
                }
            ]
        },
        "layout": {
            "contentSize": "672px",
            "wideSize": "896px"
        },
        "spacing": {
            "padding": false
        }
    },
    "styles": {
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "6px"
                },
                "color": {
                    "background": "#22A340",
                    "text": "#FFFFFF"
                },
                "shadow": "0 2px 4px rgba(0, 0, 0, 0.2)",
                "spacing": {
                    "padding": {
                        "top": "16px",
                        "right": "27px",
                        "bottom": "16px",
                        "left": "27px"
                    }
                },
                "typography": {
                    "lineHeight": "1"
                },
                "variations": {
                    "outline": {
                        "border": {
                            "width": "3px"
                        }
                    }
                }
            },
            "core/post-title": {
                "typography": {
                    "fontFamily": "PT Serif",
                    "fontSize": "48px",
                    "fontWeight": "700",
                    "lineHeight": 1
                }
            }
        }
    }
}