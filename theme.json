{
    "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
    "version": 3,
    "settings": {
        "border": {
            "radius": true,
            "radiusSizes": [
                {
                    "name": "Rounded",
                    "slug": "rounded",
                    "size": "8px"
                }
            ]
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "name": "Background",
                    "slug": "background",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Surface",
                    "slug": "surface",
                    "color": "#fdfaf1"
                },
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#c0392b"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "#101010"
                },
                {
                    "name": "Tertiary",
                    "slug": "tertiary",
                    "color": "#f9f7e8"
                },
                {
                    "name": "Border",
                    "slug": "border",
                    "color": "#e1dfcf"
                },
                {
                    "name": "Highlight",
                    "slug": "highlight",
                    "color": "#FFFBCC"
                },
                {
                    "name": "Text Main",
                    "slug": "text-main",
                    "color": "#1E1E1E"
                },
                {
                    "name": "Text Secondary",
                    "slug": "text-secondary",
                    "color": "#777777"
                },
                {
                    "name": "Button",
                    "slug": "button",
                    "color": "#22A340"
                },
                {
                    "name": "White",
                    "slug": "white",
                    "color": "#FFFFFF"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "18px",
                    "fluid": {
                        "min": "16px",
                        "max": "18px"
                    }
                },
                {
                    "name": "Normal",
                    "slug": "normal",
                    "size": "20px",
                    "fluid": {
                        "min": "18px",
                        "max": "20px"
                    }
                },
                {
                    "name": "Intro",
                    "slug": "intro",
                    "size": "24px",
                    "fluid": {
                        "min": "22px",
                        "max": "24px"
                    }
                },
                {
                    "name": "H6",
                    "slug": "h-6",
                    "size": "23px",
                    "fluid": {
                        "min": "20px",
                        "max": "23px"
                    }
                },
                {
                    "name": "H5",
                    "slug": "h-5",
                    "size": "28px",
                    "fluid": {
                        "min": "22px",
                        "max": "28px"
                    }
                },
                {
                    "name": "H4",
                    "slug": "h-4",
                    "size": "30px",
                    "fluid": {
                        "min": "25px",
                        "max": "30px"
                    }
                },
                {
                    "name": "H3",
                    "slug": "h-3",
                    "size": "34px",
                    "fluid": {
                        "min": "28px",
                        "max": "34px"
                    }
                },
                {
                    "name": "H2",
                    "slug": "h-2",
                    "size": "39px",
                    "fluid": {
                        "min": "31px",
                        "max": "39px"
                    }
                },
                {
                    "name": "H1",
                    "slug": "h-1",
                    "size": "45px",
                    "fluid": {
                        "min": "34px",
                        "max": "45px"
                    }
                },
                {
                    "name": "Huge",
                    "slug": "huge",
                    "size": "68px",
                    "fluid": {
                        "min": "43px",
                        "max": "68px"
                    }
                }
            ],
            "fontFamilies": [
                {
                    "fontFamily": "'Geomanist', system-ui, avenir next, avenir, segoe ui, helvetica neue, helvetica, Cantarell, Ubuntu, roboto, noto, arial, sans-serif",
                    "name": "Body",
                    "slug": "body"
                },
                {
                    "fontFamily": "Albra, Droid Serif, Source Serif Pro, Times New Roman, serif",
                    "name": "Heading",
                    "slug": "heading"
                }
            ]
        },
        "layout": {
            "contentSize": "672px",
            "wideSize": "896px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Small",
                    "slug": "small",
                    "shadow": "0 1px 3px rgba(0, 0, 0, 0.15)"
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "shadow": "0 4px 16px rgba(0, 0, 0, 0.12)"
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "shadow": "0 8px 32px rgba(0, 0, 0, 0.15)"
                },
                {
                    "name": "Huge",
                    "slug": "huge",
                    "shadow": "0 16px 48px rgba(0, 0, 0, 0.20)"
                }
            ]
        },
        "spacing": {
            "padding": false,
            "spacingSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "5px"
                },
                {
                    "name": "Third",
                    "slug": "third",
                    "size": "11px"
                },
                {
                    "name": "Half",
                    "slug": "half",
                    "size": "16px"
                },
                {
                    "name": "Single",
                    "slug": "single",
                    "size": "32px"
                },
                {
                    "name": "Mid",
                    "slug": "mid",
                    "size": "48px"
                },
                {
                    "name": "Double",
                    "slug": "double",
                    "size": "64px"
                },
                {
                    "name": "Triple",
                    "slug": "triple",
                    "size": "96px"
                },
                {
                    "name": "Quad",
                    "slug": "quad",
                    "size": "128px"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "#FFFFFF",
            "text": "#1E1E1E"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|body",
            "fontSize": "var:preset|font-size|normal",
            "fontWeight": "400",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#c0392b"
                },
                "typography": {
                    "textDecoration": "underline"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "none"
                    }
                }
            },
            "heading": {
                "color": {
                    "text": "#1E1E1E"
                },
                "typography": {
                    "fontFamily": "Albra, Droid Serif, Source Serif Pro, Times New Roman, serif",
                    "fontWeight": "500"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-1",
                    "fontWeight": "500",
                    "lineHeight": "1.31"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-2",
                    "fontWeight": "500",
                    "lineHeight": "1.36"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-3",
                    "fontWeight": "500",
                    "lineHeight": "1.41"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-4",
                    "fontWeight": "500",
                    "lineHeight": "1.4"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-5",
                    "fontWeight": "500",
                    "lineHeight": "1.43"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-6",
                    "fontWeight": "500",
                    "lineHeight": "1.52"
                }
            },
            "button": {
                "border": {
                    "radius": "8px"
                },
                "color": {
                    "background": "#22A340",
                    "text": "#FFFFFF"
                },
                "shadow": "0 2px 4px rgba(0, 0, 0, 0.2)",
                "spacing": {
                    "padding": {
                        "top": "16px",
                        "right": "27px",
                        "bottom": "16px",
                        "left": "27px"
                    }
                },
                "typography": {
                    "lineHeight": "1"
                }
            }
        },
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "#22A340",
                            "width": "3px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#22A340"
                        }
                    }
                }
            },
            "core/post-title": {
                "typography": {
                    "fontFamily": "Albra, Droid Serif, Source Serif Pro, Times New Roman, serif",
                    "fontSize": "var:preset|font-size|h1",
                    "fontWeight": "500",
                    "lineHeight": "1.31"
                }
            }
        }
    }
}